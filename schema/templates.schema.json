{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/wovenframe/wovenframe-registry/main/schema/templates.schema.json",
  "title": "WovenFrame template registry index",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "templates"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "templates": {
      "type": "array",
      "items": { "$ref": "#/definitions/template" }
    }
  },
  "definitions": {
    "template": {
      "type": "object",
      "required": ["id", "name", "description", "author", "repo", "license", "submittedAt"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 280 },
        "author": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "homepage": { "type": "string", "format": "uri" },
        "license": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
        "locale": { "type": "array", "items": { "type": "string" } },
        "preview": { "type": "string", "format": "uri" },
        "demoVideo": { "type": "string", "format": "uri" },
        "stars": { "type": "integer", "minimum": 0 },
        "downloads": { "type": "integer", "minimum": 0 },
        "views": { "type": "integer", "minimum": 0 },
        "lastPush": { "type": "string", "format": "date-time" },
        "syncedAt": { "type": "string", "format": "date-time" },
        "submittedAt": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["active", "deprecated", "blocked"] },
        "minAppVersion": { "type": "string" }
      }
    }
  }
}
